index 0000000..81d620c
--- /dev/null
+++ b/src/platform_impl/linux/wayland/seat/dnd.rs
@@ -0,0 +1,630 @@
+//! File drag and drop through the core `wl_data_device` protocol.
+//!
+//! A drag that offers `text/uri-list` is accepted with the copy action. Its list is read as soon
+//! as it enters a window, so the window hears `HoveredFile` for each local file while the drag is
+//! over it, `HoveredFileCancelled` when it leaves, and `DroppedFile` for each file once dropped.
+
+use std::ffi::OsStr;
+use std::fs::File;
+use std::io::{ErrorKind, Read};
+use std::os::unix::ffi::OsStrExt;
+use std::path::PathBuf;
+
+use percent_encoding::percent_decode;
+use tracing::warn;
+
+use sctk::compositor::SurfaceData;
+use sctk::data_device_manager::data_device::{DataDeviceData, DataDeviceHandler};
+use sctk::data_device_manager::data_offer::{DataOfferHandler, DragOffer};
+use sctk::data_device_manager::data_source::DataSourceHandler;
+use sctk::reexports::calloop::{PostAction, RegistrationToken};
+use sctk::reexports::client::backend::ObjectId;
+use sctk::reexports::client::protocol::wl_data_device::WlDataDevice;
+use sctk::reexports::client::protocol::wl_data_device_manager::DndAction;
+use sctk::reexports::client::protocol::wl_data_source::WlDataSource;
+use sctk::reexports::client::protocol::wl_surface::WlSurface;
+use sctk::reexports::client::{Connection, Proxy, QueueHandle};
+
+use crate::dpi::LogicalPosition;
+use crate::event::WindowEvent;
+use crate::platform_impl::wayland::state::WinitState;
+use crate::platform_impl::wayland::{make_wid, DeviceId, WindowId};
+
+const URI_LIST: &str = "text/uri-list";
+
+/// A uri-list bigger than this is not a list of files someone dragged.
+const MAX_URI_LIST: usize = 16 << 20;
+
+/// A file drag over one of our windows.
+#[derive(Debug)]
+pub struct FileDrag {
+    offer: DragOffer,
+    window_id: WindowId,
+    /// The files in the drag, once the list has been read.
+    paths: Option<Vec<PathBuf>>,
+    /// Bytes of the list read so far.
+    buffer: Vec<u8>,
+    /// The source reading the list.
+    reader: Option<RegistrationToken>,
+    /// Most recent position reported by `wl_data_device::motion`.
+    position: (f64, f64),
+    /// Position captured by `drop_performed`; URI transfer may finish later.
+    drop_position: Option<(f64, f64)>,
+    /// Whether `HoveredFile` was sent for this drag.
+    hovered: bool,
+    /// Whether the drag was dropped on the window.
+    dropped: bool,
+}
+
+impl WinitState {
+    fn cancel_drag(&mut self, drag: FileDrag) {
+        if let Some(reader) = drag.reader {
+            self.loop_handle.remove(reader);
+        }
+        if drag.hovered {
+            self.events_sink.push_window_event(WindowEvent::HoveredFileCancelled, drag.window_id);
+        }
+        // The pointer does not report a leave while a drag is in progress.
+        self.events_sink.push_window_event(
+            WindowEvent::CursorLeft {
+                device_id: crate::event::DeviceId(crate::platform_impl::DeviceId::Wayland(DeviceId)),
+            },
+            drag.window_id,
+        );
+        drag.offer.destroy();
+        self.dispatched_events = true;
+    }
+
+    /// Ends the active file drag of a seat without dropping it.
+    fn cancel_active_file_drag(&mut self, seat: &ObjectId) {
+        let drag = self.seats.get_mut(seat).and_then(|seat| seat.file_drag.take());
+        if let Some(drag) = drag {
+            self.cancel_drag(drag);
+        }
+    }
+
+    /// Starts a new drag while retaining any dropped transfer that has not reached EOF yet.
+    fn prepare_file_drag(&mut self, seat: &ObjectId) {
+        let drag = self.seats.get_mut(seat).and_then(|seat| seat.file_drag.take());
+        let Some(drag) = drag else { return };
+        if drag.dropped {
+            if let Some(seat_state) = self.seats.get_mut(seat) {
+                seat_state.pending_file_drags.push(drag);
+            }
+        } else {
+            self.cancel_drag(drag);
+        }
+    }
+
+    /// Ends all file drags of a seat, including dropped transfers still waiting on their pipes.
+    pub(super) fn cancel_file_drag(&mut self, seat: &ObjectId) {
+        let (active, pending) = {
+            let Some(seat_state) = self.seats.get_mut(seat) else { return };
+            (
+                seat_state.file_drag.take(),
+                std::mem::take(&mut seat_state.pending_file_drags),
+            )
+        };
+        if let Some(drag) = active {
+            self.cancel_drag(drag);
+        }
+        for drag in pending {
+            self.cancel_drag(drag);
+        }
+    }
+
+    /// Emits the pointer position carried by `wl_data_device::motion`.
+    ///
+    /// Wayland pointer events stop while a drag is active, but applications still need the
+    /// position to place a drop. Keep this in the same event stream as ordinary pointer motion.
+    fn file_drag_cursor_moved(&mut self, window_id: WindowId, x: f64, y: f64) {
+        let scale = match self.windows.get_mut().get(&window_id) {
+            Some(window) => window.lock().unwrap_or_else(std::sync::PoisonError::into_inner).scale_factor(),
+            None => return,
+        };
+        let position = LogicalPosition::new(x, y).to_physical(scale);
+        let device_id = crate::event::DeviceId(crate::platform_impl::DeviceId::Wayland(DeviceId));
+        self.events_sink.push_window_event(WindowEvent::CursorMoved { device_id, position }, window_id);
+        self.dispatched_events = true;
+    }
+
+    fn file_drag_mut<'a>(
+        &'a mut self,
+        seat: &ObjectId,
+        offer_id: &ObjectId,
+    ) -> Option<&'a mut FileDrag> {
+        let seat_state = self.seats.get_mut(seat)?;
+        if seat_state
+            .file_drag
+            .as_ref()
+            .is_some_and(|drag| drag.offer.inner().id() == offer_id.clone())
+        {
+            seat_state.file_drag.as_mut()
+        } else {
+            seat_state
+                .pending_file_drags
+                .iter_mut()
+                .find(|drag| drag.offer.inner().id() == offer_id.clone())
+        }
+    }
+
+    /// Finishes a dropped drag once its URI transfer reaches EOF.
+    fn finish_file_drag(&mut self, seat: &ObjectId, drag: FileDrag) {
+        // The offer carries the action the compositor settled on; finishing without one is a
+        // protocol error.
+        let selected = self
+            .seats
+            .get(seat)
+            .and_then(|seat| seat.data_device.as_ref())
+            .and_then(|device| device.data().drag_offer())
+            .filter(|offer| offer.inner() == drag.offer.inner())
+            .map_or(drag.offer.selected_action, |offer| offer.selected_action);
+        if selected == DndAction::Copy {
+            drag.offer.finish();
+        }
+        drag.offer.destroy();
+
+        let paths = drag.paths.unwrap_or_default();
+        // URI transfer can finish after the drop event. Re-emit the captured position immediately
+        // before the dropped files so consumers that process events in order use drop coordinates.
+        if !paths.is_empty() {
+            if let Some((x, y)) = drag.drop_position {
+                self.file_drag_cursor_moved(drag.window_id, x, y);
+            }
+        }
+        for path in paths {
+            self.events_sink.push_window_event(WindowEvent::DroppedFile(path), drag.window_id);
+        }
+        self.dispatched_events = true;
+    }
+
+    /// Reports what is known about a seat's file drag: hovered files once their list is read, and
+    /// dropped files once the drag is dropped and read, which also finishes it.
+    fn advance_file_drag(&mut self, seat: &ObjectId, offer_id: &ObjectId) {
+        let mut pending_index = None;
+        let active = self
+            .seats
+            .get(seat)
+            .and_then(|seat| seat.file_drag.as_ref())
+            .is_some_and(|drag| drag.offer.inner().id() == offer_id.clone());
+
+        {
+            let Some(seat_state) = self.seats.get_mut(seat) else { return };
+            let drag = if active {
+                seat_state.file_drag.as_mut()
+            } else {
+                let Some(index) = seat_state
+                    .pending_file_drags
+                    .iter()
+                    .position(|drag| drag.offer.inner().id() == offer_id.clone())
+                else {
+                    return;
+                };
+                pending_index = Some(index);
+                seat_state.pending_file_drags.get_mut(index)
+            };
+            let Some(drag) = drag else { return };
+            let Some(paths) = drag.paths.as_ref() else { return };
+
+            if !drag.hovered {
+                drag.hovered = true;
+                for path in paths {
+                    self.events_sink
+                        .push_window_event(WindowEvent::HoveredFile(path.clone()), drag.window_id);
+                }
+                self.dispatched_events = true;
+            }
+            if !drag.dropped {
+                return;
+            }
+        }
+
+        let Some(seat_state) = self.seats.get_mut(seat) else { return };
+        let drag = if active {
+            seat_state.file_drag.take()
+        } else {
+            let Some(index) = pending_index else { return };
+            Some(seat_state.pending_file_drags.remove(index))
+        };
+        if let Some(drag) = drag {
+            self.finish_file_drag(seat, drag);
+        }
+    }
+
+    /// Reads the part of a seat's list that is ready, telling the loop whether to keep watching.
+    fn read_file_drag(
+        &mut self,
+        seat: &ObjectId,
+        offer_id: &ObjectId,
+        mut pipe: &File,
+    ) -> PostAction {
+        let Some(drag) = self.file_drag_mut(seat, offer_id) else {
+            return PostAction::Remove;
+        };
+
+        // The pipe is ready, so one read does not block.
+        let mut chunk = [0u8; 4096];
+        let (action, advance) = match pipe.read(&mut chunk) {
+            Ok(0) => {
+                drag.reader = None;
+                drag.paths = Some(parse_uri_list(&drag.buffer));
+                drag.buffer = Vec::new();
+                (PostAction::Remove, true)
+            },
+            Ok(read) => {
+                let new_len =
+                    drag.buffer.len().checked_add(read).map_or(MAX_URI_LIST + 1, |len| len);
+                if new_len > MAX_URI_LIST {
+                    warn!("Dragged file list is too large");
+                    drag.reader = None;
+                    drag.buffer.clear();
+                    drag.paths = Some(Vec::new());
+                    (PostAction::Remove, true)
+                } else {
+                    drag.buffer.extend_from_slice(&chunk[..read]);
+                    (PostAction::Continue, false)
+                }
+            },
+            Err(error)
+                if matches!(error.kind(), ErrorKind::Interrupted | ErrorKind::WouldBlock) =>
+            {
+                (PostAction::Continue, false)
+            },
+            Err(error) => {
+                warn!("Failed to read a dragged file list: {error}");
+                drag.reader = None;
+                drag.paths = Some(Vec::new());
+                (PostAction::Remove, true)
+            },
+        };
+        if advance {
+            self.advance_file_drag(seat, offer_id);
+        }
+        action
+    }
+}
+
+impl DataDeviceHandler for WinitState {
+    fn enter(
+        &mut self,
+        conn: &Connection,
+        _: &QueueHandle<Self>,
+        data_device: &WlDataDevice,
+        x: f64,
+        y: f64,
+        surface: &WlSurface,
+    ) {
+        let Some(data) = data_device.data::<DataDeviceData>() else { return };
+        let seat = data.seat().id();
+        self.prepare_file_drag(&seat);
+
+        let Some(offer) = data.drag_offer() else { return };
+        // A CSD frame can be the surface receiving the data-device event, while winit's window
+        // events belong to its parent surface.
+        let parent_surface =
+            surface.data::<SurfaceData>().and_then(|data| data.parent_surface()).unwrap_or(surface);
+        let window_id = make_wid(parent_surface);
+        let offers_files = offer.with_mime_types(|types| types.iter().any(|mime| mime == URI_LIST));
+        if !offers_files || !self.windows.get_mut().contains_key(&window_id) {
+            offer.accept_mime_type(offer.serial, None);
+            let _ = conn.flush();
+            return;
+        }
+
+        offer.accept_mime_type(offer.serial, Some(URI_LIST.to_owned()));
+        offer.set_actions(DndAction::Copy, DndAction::Copy);
+        let pipe = match offer.receive(URI_LIST.to_owned()) {
+            Ok(pipe) => pipe,
+            Err(error) => {
+                warn!("Failed to receive a dragged file list: {error}");
+                offer.destroy();
+                let _ = conn.flush();
+                return;
+            },
+        };
+        // The source only writes once the compositor has our request.
+        let _ = conn.flush();
+
+        let reader_seat = seat.clone();
+        let reader_offer = offer.inner().id();
+        let reader = self
+            .loop_handle
+            .insert_source(pipe, move |_, file, state| {
+                state.read_file_drag(&reader_seat, &reader_offer, file)
+            });
+        let reader = match reader {
+            Ok(reader) => reader,
+            Err(error) => {
+                warn!("Failed to watch a dragged file list: {error}");
+                offer.destroy();
+                let _ = conn.flush();
+                return;
+            },
+        };
+
+        let Some(seat_state) = self.seats.get_mut(&seat) else {
+            self.loop_handle.remove(reader);
+            offer.destroy();
+            let _ = conn.flush();
+            return;
+        };
+        seat_state.file_drag = Some(FileDrag {
+            offer,
+            window_id,
+            paths: None,
+            buffer: Vec::new(),
+            reader: Some(reader),
+            position: (x, y),
+            drop_position: None,
+            hovered: false,
+            dropped: false,
+        });
+        self.file_drag_cursor_moved(window_id, x, y);
+    }
+
+    fn leave(&mut self, _: &Connection, _: &QueueHandle<Self>, data_device: &WlDataDevice) {
+        let Some(data) = data_device.data::<DataDeviceData>() else { return };
+        let seat = data.seat().id();
+        // A drop is followed by a leave; that drag stays until its files are delivered.
+        let dropped = self
+            .seats
+            .get(&seat)
+            .and_then(|seat| seat.file_drag.as_ref())
+            .is_some_and(|drag| drag.dropped);
+        if !dropped {
+            self.cancel_active_file_drag(&seat);
+        }
+    }
+
+    fn motion(
+        &mut self,
+        conn: &Connection,
+        _: &QueueHandle<Self>,
+        data_device: &WlDataDevice,
+        x: f64,
+        y: f64,
+    ) {
+        let Some(data) = data_device.data::<DataDeviceData>() else { return };
+        let seat = data.seat().id();
+        if let Some(drag) = self.seats.get_mut(&seat).and_then(|seat| seat.file_drag.as_mut()) {
+            drag.position = (x, y);
+        }
+        let Some(window_id) =
+            self.seats.get(&seat).and_then(|seat| seat.file_drag.as_ref()).map(|drag| drag.window_id)
+        else {
+            return;
+        };
+        // Keep the drop position available to applications; pointer events stop during a drag.
+        self.file_drag_cursor_moved(window_id, x, y);
+
+        // Some compositors want the type accepted again as the drag moves. The actions are not
+        // set again: that restarts the negotiation and can turn a quick drop into a leave.
+        if let Some(drag) = self.seats.get(&seat).and_then(|seat| seat.file_drag.as_ref()) {
+            drag.offer.accept_mime_type(drag.offer.serial, Some(URI_LIST.to_owned()));
+            let _ = conn.flush();
+        }
+    }
+
+    // The clipboard reads the device's current selection when asked.
+    fn selection(&mut self, _: &Connection, _: &QueueHandle<Self>, _: &WlDataDevice) {}
+
+    fn drop_performed(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        data_device: &WlDataDevice,
+    ) {
+        let Some(data) = data_device.data::<DataDeviceData>() else { return };
+        let seat = data.seat().id();
+        let current = data.drag_offer();
+        let Some(offer_id) = self
+            .seats
+            .get(&seat)
+            .and_then(|seat| seat.file_drag.as_ref())
+            .map(|drag| drag.offer.inner().id())
+        else {
+            return;
+        };
+        let Some(drag) = self.seats.get_mut(&seat).and_then(|seat| seat.file_drag.as_mut()) else {
+            return;
+        };
+        if let Some(current) = current.filter(|current| current.inner() == drag.offer.inner()) {
+            drag.offer = current;
+        }
+        drag.drop_position = Some(drag.position);
+        drag.dropped = true;
+        self.advance_file_drag(&seat, &offer_id);
+    }
+}
+
+impl DataOfferHandler for WinitState {
+    fn source_actions(
+        &mut self,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+        _: &mut DragOffer,
+        _: DndAction,
+    ) {
+    }
+
+    fn selected_action(
+        &mut self,
+        conn: &Connection,
+        _: &QueueHandle<Self>,
+        offer: &mut DragOffer,
+        _: DndAction,
+    ) {
+        let ours = self.seats.values_mut().find_map(|seat| {
+            if seat.file_drag.as_ref().is_some_and(|drag| drag.offer.inner() == offer.inner()) {
+                seat.file_drag.as_mut()
+            } else {
+                seat.pending_file_drags
+                    .iter_mut()
+                    .find(|drag| drag.offer.inner() == offer.inner())
+            }
+        });
+        if let Some(drag) = ours {
+            drag.offer.selected_action = offer.selected_action;
+            offer.accept_mime_type(offer.serial, Some(URI_LIST.to_owned()));
+            let _ = conn.flush();
+        }
+    }
+}
